# Copia este archivo a .env y ajusta los valores
PORT=3000
NODE_ENV=development

# Base de datos (adopta_db)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=adopta_db

# Seguridad: usa un secreto largo y aleatorio en producción
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES=7d

# URL pública del servidor (para armar los links de las fotos). Vacío = se detecta de la petición.
PUBLIC_BASE_URL=

# Solicitudes: si es true, al crear una solicitud se pide la documentación automáticamente.
# Ponlo en false cuando el portal web de la organización sea quien solicite los documentos.
AUTO_SOLICITAR_DOCUMENTOS=true
DIAS_LIMITE_DOCUMENTOS=15

# Recuperación de contraseña. En desarrollo el código se devuelve en la respuesta (DEV_EXPOSE_RESET_CODE=true).
# En producción ponlo en false y configura SMTP para enviarlo por correo.
DEV_EXPOSE_RESET_CODE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Adopta+ <no-responder@adopta.com>"
