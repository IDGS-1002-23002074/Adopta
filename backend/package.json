{
  "name": "adopta-api",
  "version": "1.0.0",
  "description": "API REST de Adopta+ (MySQL adopta_db) para la app móvil y la web",
  "main": "src/server.js",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/init-db.js",
    "seed": "node scripts/seed.js",
    "db:reset": "node scripts/init-db.js && node scripts/seed.js",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.14"
  }
}
