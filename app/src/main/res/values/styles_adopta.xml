<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Adopta.Display" parent="">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/adopta_text</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
    </style>
    <style name="Adopta.Title" parent="">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/adopta_text</item>
    </style>
    <style name="Adopta.Subtitle" parent="">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/adopta_gray</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Adopta.Section" parent="">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/adopta_text</item>
    </style>
    <style name="Adopta.CardTitle" parent="">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/adopta_text</item>
    </style>
    <style name="Adopta.Body" parent="">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/adopta_text</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="Adopta.Caption" parent="">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/adopta_gray</item>
    </style>
    <style name="Adopta.Link" parent="">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/adopta_teal_dark</item>
        <item name="android:padding">4dp</item>
    </style>

    <style name="Adopta.TextField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxBackgroundColor">@color/adopta_cream</item>
        <item name="boxStrokeColor">@color/box_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/adopta_teal_dark</item>
        <item name="android:textColorHint">@color/adopta_gray</item>
        <item name="startIconTint">@color/adopta_teal</item>
        <item name="endIconTint">@color/adopta_teal</item>
    </style>
    <style name="Adopta.Dropdown" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxBackgroundColor">@color/adopta_cream</item>
        <item name="boxStrokeColor">@color/box_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/adopta_teal_dark</item>
        <item name="endIconTint">@color/adopta_teal</item>
    </style>

    <style name="Adopta.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/adopta_teal_dark</item>
        <item name="cornerRadius">28dp</item>
        <item name="iconTint">@color/white</item>
        <item name="rippleColor">@color/adopta_mint</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Adopta.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/adopta_blue_light</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="iconTint">@color/adopta_teal_dark</item>
        <item name="rippleColor">@color/adopta_blue_light</item>
        <item name="android:textColor">@color/adopta_teal_dark</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">52dp</item>
    </style>
    <style name="Adopta.Button.Tonal" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/adopta_cream</item>
        <item name="cornerRadius">28dp</item>
        <item name="rippleColor">@color/adopta_blue_light</item>
        <item name="android:textColor">@color/adopta_teal_dark</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">52dp</item>
    </style>
    <style name="Adopta.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="rippleColor">@color/adopta_blue_light</item>
        <item name="android:textColor">@color/adopta_teal_dark</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Adopta.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/adopta_line</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/adopta_cream</item>
            </style>
    <style name="Adopta.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/adopta_line</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">38dp</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Adopta.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Adopta.RoundedPhoto" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="Adopta.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemBackground">@null</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemRippleColor">@color/adopta_blue_light</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">16dp</item>
        <item name="android:background">@color/white</item>
    </style>

    <style name="Adopta.Animation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>
</resources>
