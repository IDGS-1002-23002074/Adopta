<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Texto -->
    <style name="Adopta.Title" parent="">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/adopta_text</item>
    </style>
    <style name="Adopta.Subtitle" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/adopta_teal</item>
    </style>
    <style name="Adopta.Section" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/adopta_text</item>
    </style>
    <style name="Adopta.CardTitle" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/adopta_text</item>
    </style>
    <style name="Adopta.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/adopta_text</item>
    </style>
    <style name="Adopta.Caption" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/adopta_gray</item>
    </style>
    <style name="Adopta.Link" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/adopta_teal_dark</item>
        <item name="android:padding">4dp</item>
    </style>

    <!-- Campos de texto -->
    <style name="Adopta.TextField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/adopta_teal</item>
        <item name="hintTextColor">@color/adopta_teal</item>
        <item name="startIconTint">@color/adopta_teal</item>
        <item name="endIconTint">@color/adopta_teal</item>
    </style>
    <style name="Adopta.Dropdown" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/adopta_teal</item>
        <item name="hintTextColor">@color/adopta_teal</item>
        <item name="endIconTint">@color/adopta_teal</item>
    </style>

    <!-- Botones -->
    <style name="Adopta.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/adopta_orange</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconTint">@color/adopta_text</item>
        <item name="android:textColor">@color/adopta_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Adopta.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/adopta_teal</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconTint">@color/adopta_teal_dark</item>
        <item name="android:textColor">@color/adopta_teal_dark</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Tarjetas y chips -->
    <style name="Adopta.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/adopta_blue_light</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Adopta.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>
</resources>
