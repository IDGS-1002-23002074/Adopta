<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="0dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Adopta.CardTitle"
        android:text="Nombre completo"
        android:textSize="14sp"
        android:layout_marginTop="0dp"
        android:layout_marginStart="2dp"
        android:labelFor="@id/etRefNombre" />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilRefNombre"
        style="@style/Adopta.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:startIconDrawable="@drawable/ic_person">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRefNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName|textCapWords"
            android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Adopta.CardTitle"
        android:text="Teléfono"
        android:textSize="14sp"
        android:layout_marginTop="14dp"
        android:layout_marginStart="2dp"
        android:labelFor="@id/etRefTelefono" />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilRefTelefono"
        style="@style/Adopta.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:startIconDrawable="@drawable/ic_phone">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRefTelefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Adopta.CardTitle"
        android:text="Relación (amigo, familiar…)"
        android:textSize="14sp"
        android:layout_marginTop="14dp"
        android:layout_marginStart="2dp"
        android:labelFor="@id/etRefRelacion" />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilRefRelacion"
        style="@style/Adopta.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRefRelacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Adopta.CardTitle"
        android:text="Años de conocerse (opcional)"
        android:textSize="14sp"
        android:layout_marginTop="14dp"
        android:layout_marginStart="2dp"
        android:labelFor="@id/etRefAnios" />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilRefAnios"
        style="@style/Adopta.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRefAnios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:importantForAutofill="no"
            android:maxLength="2" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
