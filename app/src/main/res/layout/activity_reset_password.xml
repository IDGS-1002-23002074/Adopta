<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/adopta_teal_dark"
        app:title=""
        app:titleTextColor="@color/adopta_text"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Subtitle1" />
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="8dp"
            android:paddingBottom="28dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:adjustViewBounds="true"
                android:contentDescription="Adopta+"
                android:src="@drawable/logo_wordmark" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.Title"
                android:textSize="26sp"
                android:text="Cambiar contraseña"
                android:layout_marginTop="32dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.Subtitle"
                android:text="Escribe el código de 6 dígitos que enviamos a:"
                android:layout_marginTop="4dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvCorreo"
                style="@style/Adopta.CardTitle"
                android:layout_marginTop="6dp"
                tools:text="******564@gmail.com" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvCodigoDev"
                style="@style/Adopta.Caption"
                android:layout_marginTop="6dp"
                android:textColor="@color/adopta_warning"
                android:visibility="gone"
                tools:text="Código de desarrollo: 123456" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.CardTitle"
                android:text="Código de verificación"
                android:textSize="14sp"
                android:layout_marginTop="20dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etCodigo" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCodigo"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:startIconDrawable="@drawable/ic_shield_check">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:importantForAutofill="no"
                    android:maxLength="6" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.CardTitle"
                android:text="Nueva contraseña"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etNueva" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNueva"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:startIconDrawable="@drawable/ic_lock"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNueva"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:importantForAutofill="yes"
                    android:autofillHints="newPassword" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.CardTitle"
                android:text="Confirmar contraseña"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etConfirmar" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirmar"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:startIconDrawable="@drawable/ic_lock"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:importantForAutofill="yes"
                    android:autofillHints="newPassword" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                style="@style/Adopta.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Guardar contraseña"
                android:layout_marginTop="24dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvReenviar"
                style="@style/Adopta.Link"
                android:text="Volver a enviar"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:background="?attr/selectableItemBackground" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvTerminos"
                style="@style/Adopta.Caption"
                android:text="Términos y condiciones / Políticas de privacidad"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:textColor="@color/adopta_teal_dark" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
