<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".PetDetailActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/adopta_cream">
                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_pets"
                        app:tint="@color/adopta_teal"
                        android:alpha="0.4"/>
                    <ImageView
                        android:id="@+id/ivMascota"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Foto de la mascota"/>
                </FrameLayout>
                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="16dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/adopta_teal_dark"
                    android:background="@drawable/bg_circle_white"
                    android:contentDescription="Volver"/>
                <ImageButton
                    android:id="@+id/btnFavorito"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="16dp"
                    android:src="@drawable/ic_favorite"
                    app:tint="@color/adopta_orange"
                    android:background="@drawable/bg_circle_white"
                    android:contentDescription="Agregar a favoritos"/>
            </FrameLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="-24dp"
                android:padding="24dp"
                android:background="@drawable/bg_sheet_top">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Adopta.Title"
                    tools:text="Luna"
                    android:id="@+id/tvNombre"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Adopta.Subtitle"
                    tools:text="León, Guanajuato · Refugio Huellitas"
                    android:id="@+id/tvUbicacion"
                    android:layout_marginTop="2dp"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:id="@+id/chipEdad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textSize="12sp"
                        android:textColor="@color/adopta_teal_dark"
                        android:textStyle="bold"
                        tools:text="2 años"/>
                    <TextView
                        android:id="@+id/chipSexo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textSize="12sp"
                        android:textColor="@color/adopta_teal_dark"
                        android:textStyle="bold"
                        tools:text="Hembra"
                        android:layout_marginStart="8dp"/>
                    <TextView
                        android:id="@+id/chipTamano"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textSize="12sp"
                        android:textColor="@color/adopta_teal_dark"
                        android:textStyle="bold"
                        tools:text="Mediana"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Adopta.Section"
                    android:text="Sobre mí"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Adopta.Body"
                    tools:text="Luna es cariñosa, juguetona y se lleva bien con otros gatos. Busca un hogar tranquilo donde pueda sentirse segura."
                    android:id="@+id/tvDescripcion"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Adopta.Section"
                    android:text="Salud"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/chipVacunada"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textSize="12sp"
                        android:textColor="@color/adopta_teal_dark"
                        android:textStyle="bold"
                        tools:text="Vacunada"/>
                    <TextView
                        android:id="@+id/chipEsterilizada"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textSize="12sp"
                        android:textColor="@color/adopta_teal_dark"
                        android:textStyle="bold"
                        tools:text="Esterilizada"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/white"
        android:elevation="8dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdoptar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="0dp"
            android:text="Solicitar adopción"
            style="@style/Adopta.Button"/>
    </LinearLayout>
</LinearLayout>
