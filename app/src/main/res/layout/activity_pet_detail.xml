<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".PetDetailActivity"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/adopta_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="440dp">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFotos"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never" />
                <TextView
                    android:id="@+id/tvIndice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_glass_pill"
                    android:fontFamily="@font/inter_medium"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="1/3" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_gravity="top"
                    android:background="@drawable/bg_scrim_top" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-32dp"
                android:background="@drawable/bg_sheet_top"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="28dp"
                android:paddingBottom="32dp">

                <TextView
                    android:id="@+id/tvNombre"
                    style="@style/Adopta.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Luna" />
                <TextView
                    android:id="@+id/tvRaza"
                    style="@style/Adopta.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    tools:text="Mestiza · Gato" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_location"
                        app:tint="@color/adopta_teal_dark"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/tvUbicacion"
                        style="@style/Adopta.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/adopta_teal_dark"
                        android:textSize="13sp"
                        tools:text="León, Gto. · 3.2 km" />
                </LinearLayout>

                <TextView
                    android:id="@+id/chipEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_status_green"
                    android:drawableStart="@drawable/ic_check"
                    android:drawableTint="@color/adopta_success"
                    android:drawablePadding="6dp"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/adopta_success"
                    android:textSize="13sp"
                    tools:text="Disponible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tile"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/adopta_teal_dark"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:id="@+id/tileEdad"
                            style="@style/Adopta.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="15sp"
                            tools:text="2 años" />
                        <TextView
                            style="@style/Adopta.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Edad" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tile"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_pets"
                            app:tint="@color/adopta_teal_dark"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:id="@+id/tileTamano"
                            style="@style/Adopta.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="15sp"
                            tools:text="Mediana" />
                        <TextView
                            style="@style/Adopta.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tamaño" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tile"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_zap"
                            app:tint="@color/adopta_teal_dark"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:id="@+id/tileSexo"
                            style="@style/Adopta.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="15sp"
                            tools:text="Media" />
                        <TextView
                            style="@style/Adopta.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sexo" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/Adopta.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Descripción" />
                <TextView
                    android:id="@+id/tvDescripcion"
                    style="@style/Adopta.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    tools:text="Luna es cariñosa y juguetona." />

                <TextView
                    android:id="@+id/tvComportamientoTitulo"
                    style="@style/Adopta.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Comportamiento" />
                <TextView
                    android:id="@+id/tvComportamiento"
                    style="@style/Adopta.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvPersonalidadTitulo"
                    style="@style/Adopta.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Características" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgPersonalidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp" />

                <TextView
                    style="@style/Adopta.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Salud" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/chipVacunada"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:drawableStart="@drawable/ic_check"
                        android:drawableTint="@color/adopta_teal_dark"
                        android:drawablePadding="6dp"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="Vacunas al día"
                        android:textColor="@color/adopta_teal_dark"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/chipEsterilizada"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip"
                        android:drawableStart="@drawable/ic_check"
                        android:drawableTint="@color/adopta_teal_dark"
                        android:drawablePadding="6dp"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="Esterilizado/a"
                        android:textColor="@color/adopta_teal_dark"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEstadoSalud"
                    style="@style/Adopta.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <!-- Refugio: confianza -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Adopta.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    app:cardElevation="4dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivRefugio"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:importantForAccessibility="no"
                            app:shapeAppearanceOverlay="@style/Adopta.Circle" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:id="@+id/tvRefugio"
                                    style="@style/Adopta.CardTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="Refugio Huellitas" />
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginStart="6dp"
                                    android:src="@drawable/ic_shield_check"
                                    app:tint="@color/adopta_teal_dark"
                                    android:contentDescription="Refugio verificado" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/tvRespuesta"
                                style="@style/Adopta.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                tools:text="Responde en ~2 h" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLlamar"
                        style="@style/Adopta.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="Llamar"
                        app:icon="@drawable/ic_phone" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCorreo"
                        style="@style/Adopta.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="Escribir"
                        app:icon="@drawable/ic_email" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        app:indicatorColor="@color/adopta_teal_dark" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/bg_glass_circle"
        android:contentDescription="Volver"
        android:padding="10dp"
        android:src="@drawable/ic_back"
        app:tint="@color/white" />

    <ImageButton
        android:id="@+id/btnFavorito"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_glass_circle"
        android:contentDescription="Guardar"
        android:padding="10dp"
        android:src="@drawable/ic_bookmark_outline"
        app:tint="@color/white" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="16dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdoptar"
            style="@style/Adopta.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Quiero conocerla" />
    </LinearLayout>
</FrameLayout>
