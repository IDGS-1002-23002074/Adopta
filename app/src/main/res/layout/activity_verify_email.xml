<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_screen">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/adopta_teal_dark"
        app:title=""
        app:titleTextColor="@color/adopta_text"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Subtitle1" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="16dp"
            android:paddingBottom="28dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:adjustViewBounds="true"
                android:contentDescription="Adopta+"
                android:src="@drawable/logo_wordmark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.Title"
                android:textSize="26sp"
                android:text="Verifica tu correo"
                android:layout_marginTop="32dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.Subtitle"
                android:text="¡Ya casi terminamos! Escribe el código de 6 dígitos que enviamos a:"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvCorreoVerificacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.CardTitle"
                android:layout_marginTop="6dp"
                tools:text="******564@gmail.com" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.CardTitle"
                android:text="Código de verificación"
                android:textSize="14sp"
                android:layout_marginTop="20dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etCodigoVerificacion" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCodigoVerificacion"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:startIconDrawable="@drawable/ic_shield_check">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCodigoVerificacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:importantForAutofill="no"
                    android:maxLength="6" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerificarCorreo"
                style="@style/Adopta.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Verificar correo"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/tvContadorReenvio"
                style="@style/Adopta.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:text="Puedes solicitar otro código en 60s" />

            <TextView
                android:id="@+id/btnReenviarCodigo"
                style="@style/Adopta.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Volver a enviar"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.Caption"
                android:text="Revisa también tu carpeta de spam o correo no deseado."
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/tvTerminos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.Caption"
                android:text="Términos y condiciones / Políticas de privacidad"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="94dp"
                android:textColor="@color/adopta_teal_dark" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>