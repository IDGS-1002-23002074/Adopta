<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_top"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_handle" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvStepLabel"
        style="@style/Adopta.Caption"
        android:layout_marginTop="18dp"
        android:textColor="@color/adopta_teal_dark" />
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        app:indicatorColor="@color/adopta_teal_dark"
        app:trackColor="@color/adopta_blue_light"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvResumen"
        style="@style/Adopta.Caption"
        android:layout_marginTop="10dp" />
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/step1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvStep1Title"
                    style="@style/Adopta.Display"
                    android:layout_marginTop="14dp"
                    android:textSize="24sp"
                    android:text="Cuéntanos de tu hogar" />
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:buttonTint="@color/adopta_teal_dark"
                    android:text="Vivo en un lugar donde se permiten mascotas"
                    android:textColor="@color/adopta_text"
                    android:textSize="15sp" />
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:buttonTint="@color/adopta_teal_dark"
                    android:text="Todas las personas de mi hogar están de acuerdo"
                    android:textColor="@color/adopta_text"
                    android:textSize="15sp" />
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:buttonTint="@color/adopta_teal_dark"
                    android:text="Puedo cubrir alimentación, atención veterinaria y cuidados"
                    android:textColor="@color/adopta_text"
                    android:textSize="15sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/step2"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Adopta.Display"
                    android:layout_marginTop="14dp"
                    android:textSize="24sp"
                    android:text="Un compromiso de por vida" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Adopta.Body"
                    android:layout_marginTop="8dp"
                    android:text="Adoptar es una decisión de años. La organización revisará tu solicitud y te pedirá documentos para conocerte mejor." />
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:buttonTint="@color/adopta_teal_dark"
                    android:text="Me comprometo a cuidarla toda su vida, no abandonarla y permitir el seguimiento posterior"
                    android:textColor="@color/adopta_text"
                    android:textSize="15sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/step3"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Adopta.Display"
                    android:layout_marginTop="14dp"
                    android:textSize="24sp"
                    android:text="Cuéntanos más" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Adopta.CardTitle"
                    android:text="¿Por qué quieres adoptar?"
                    android:textSize="14sp"
                    android:layout_marginTop="14dp"
                    android:layout_marginStart="2dp"
                    android:labelFor="@id/etMotivo" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilMotivo"
                    style="@style/Adopta.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMotivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine|textCapSentences"
                        android:importantForAutofill="no"
                        android:minLines="3"
                        android:gravity="top"
                        android:maxLength="2000" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Adopta.CardTitle"
                    android:text="Experiencia con mascotas (opcional)"
                    android:textSize="14sp"
                    android:layout_marginTop="14dp"
                    android:layout_marginStart="2dp"
                    android:labelFor="@id/etExperiencia" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilExperiencia"
                    style="@style/Adopta.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etExperiencia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine|textCapSentences"
                        android:importantForAutofill="no"
                        android:minLines="2"
                        android:gravity="top"
                        android:maxLength="2000" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Adopta.CardTitle"
                    android:text="Describe tu vivienda"
                    android:textSize="14sp"
                    android:layout_marginTop="14dp"
                    android:layout_marginStart="2dp"
                    android:labelFor="@id/etVivienda" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilVivienda"
                    style="@style/Adopta.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etVivienda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine|textCapSentences"
                        android:importantForAutofill="no"
                        android:minLines="2"
                        android:gravity="top"
                        android:maxLength="2000"
                        android:hint="Casa o departamento, patio, cercado…" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="20dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAtras"
            style="@style/Adopta.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:text="Atrás"
            android:layout_marginTop="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSiguiente"
            style="@style/Adopta.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:text="Continuar"
            android:layout_marginTop="0dp"
            android:layout_weight="2" />
    </LinearLayout>
</LinearLayout>
