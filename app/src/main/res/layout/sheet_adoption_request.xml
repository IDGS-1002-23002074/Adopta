<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_handle" />

    <TextView
        android:id="@+id/tvStepLabel"
        style="@style/Adopta.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textColor="@color/adopta_teal_dark" />
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        app:indicatorColor="@color/adopta_teal_dark"
        app:trackColor="@color/adopta_blue_light"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp" />

    <!-- Paso 1 -->
    <LinearLayout
        android:id="@+id/step1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvStep1Title"
            style="@style/Adopta.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Cuéntanos de tu hogar"
            android:textSize="24sp" />
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:buttonTint="@color/adopta_teal_dark"
            android:text="Vivo en un lugar donde se permiten mascotas"
            android:textColor="@color/adopta_text"
            android:textSize="15sp" />
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/adopta_teal_dark"
            android:text="Tengo tiempo y espacio para cuidarla"
            android:textColor="@color/adopta_text"
            android:textSize="15sp" />
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/adopta_teal_dark"
            android:text="Todas las personas de mi hogar están de acuerdo"
            android:textColor="@color/adopta_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Paso 2 -->
    <LinearLayout
        android:id="@+id/step2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            style="@style/Adopta.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Un compromiso de largo plazo"
            android:textSize="24sp" />
        <TextView
            style="@style/Adopta.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Adoptar es una decisión de años. Durante el periodo de adaptación te pediremos registrar su avance y el refugio podrá visitarte." />
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:buttonTint="@color/adopta_teal_dark"
            android:text="Entiendo y acepto el compromiso y el seguimiento"
            android:textColor="@color/adopta_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Paso 3 -->
    <LinearLayout
        android:id="@+id/step3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            style="@style/Adopta.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Revisa y envía"
            android:textSize="24sp" />
        <TextView
            android:id="@+id/tvResumen"
            style="@style/Adopta.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
        <TextView
            style="@style/Adopta.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="El refugio revisará tu perfil y te responderá dentro de la app. Mantén toda la conversación aquí y nunca hagas pagos fuera de ella." />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAtras"
            style="@style/Adopta.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:text="Atrás" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSiguiente"
            style="@style/Adopta.Button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Continuar" />
    </LinearLayout>
</LinearLayout>
