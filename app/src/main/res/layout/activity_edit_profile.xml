<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/adopta_teal_dark"
        app:title="Editar perfil"
        app:titleTextColor="@color/adopta_text"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Subtitle1" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="@color/adopta_teal_dark" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="32dp">

            <!-- Avatar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginTop="4dp">
                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/Adopta.Circle" />
                    <TextView
                        android:id="@+id/tvIniciales"
                        style="@style/Adopta.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="30sp"
                        android:layout_gravity="center"
                        android:textColor="@color/adopta_teal_dark" />
                </FrameLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFoto"
                    style="@style/Adopta.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Cambiar foto"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- SECCIÓN 1: DATOS PERSONALES -->
            <TextView
                style="@style/Adopta.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Datos personales"
                android:layout_marginTop="12dp" />

            <TextView
                style="@style/Adopta.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre(s)"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etNombre" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNombre"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:startIconDrawable="@drawable/ic_person">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="60"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Adopta.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apellido paterno"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etPaterno" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPaterno"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPaterno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="60"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Adopta.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apellido materno (opcional)"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etMaterno" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMaterno"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMaterno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="60"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Adopta.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha de nacimiento"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etFechaNac" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFechaNac"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:startIconDrawable="@drawable/ic_calendar">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFechaNac"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Selecciona tu fecha de nacimiento"
                    android:inputType="none"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Adopta.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ocupación"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etOcupacion" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilOcupacion"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOcupacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="80"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Adopta.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Teléfono"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etTelefono" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTelefono"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:startIconDrawable="@drawable/ic_phone">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:maxLength="10"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- SECCIÓN 2: DOMICILIO Y VIVIENDA -->
            <TextView
                style="@style/Adopta.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Domicilio y vivienda"
                android:layout_marginTop="24dp" />

            <TextView
                style="@style/Adopta.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dirección"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etDireccion" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDireccion"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:startIconDrawable="@drawable/ic_location">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDireccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPostalAddress|textCapSentences"
                    android:maxLength="150"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Adopta.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ciudad"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etCiudad" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCiudad"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCiudad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLength="80"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Adopta.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Código postal"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etCP" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCP"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej. 37000"
                    android:inputType="number"
                    android:importantForAutofill="no"
                    android:maxLength="5" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Adopta.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo de vivienda"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etTipoVivienda" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTipoVivienda"
                style="@style/Adopta.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/etTipoVivienda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Selecciona una opción"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- SECCIÓN 3: EXPERIENCIA CON MASCOTAS -->
            <TextView
                style="@style/Adopta.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Experiencia con mascotas"
                android:layout_marginTop="24dp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbTieneMascotas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="48dp"
                android:text="Actualmente tengo mascotas"
                android:textColor="@color/adopta_text"
                android:textSize="15sp"
                android:fontFamily="@font/inter_regular"
                app:buttonTint="@color/adopta_teal_dark" />

            <TextView
                style="@style/Adopta.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cuéntanos tu experiencia previa"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etExperiencia" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilExperiencia"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etExperiencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej. He tenido perros y gatos anteriormente..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:importantForAutofill="no"
                    android:minLines="3"
                    android:gravity="top"
                    android:maxLength="2000" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- SECCIÓN 4: CONTACTO DE EMERGENCIA -->
            <TextView
                style="@style/Adopta.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contacto de emergencia"
                android:layout_marginTop="24dp" />

            <TextView
                style="@style/Adopta.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre completo"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etEmNombre" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmNombre"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:startIconDrawable="@drawable/ic_person">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="100"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Adopta.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Teléfono"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etEmTelefono" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmTelefono"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:startIconDrawable="@drawable/ic_phone">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:maxLength="10"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Adopta.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parentesco"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etEmParentesco" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmParentesco"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmParentesco"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej. Madre, Hermano, Amigo/a"
                    android:inputType="textCapSentences"
                    android:maxLength="50"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                style="@style/Adopta.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Guardar cambios"
                android:layout_marginTop="24dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>