<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".RegisterTrackingActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Registrar seguimiento"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="@color/adopta_text"
        app:navigationIconTint="@color/adopta_teal_dark"
        android:background="@color/white"
        android:elevation="2dp"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.Title"
                tools:text="Seguimiento de Luna"
                android:id="@+id/tvMascota"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.Subtitle"
                android:text="Cuéntanos cómo va su adaptación"
                android:layout_marginTop="4dp"/>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Adopta.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tilEstado"
                android:layout_marginTop="24dp"
                android:hint="Estado de adaptación">
                <AutoCompleteTextView
                    android:id="@+id/actEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    tools:text="En adaptación"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tilFecha"
                android:layout_marginTop="16dp"
                android:hint="Fecha">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true"
                    tools:text="10/10/2026"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.Section"
                android:text="Nivel de adaptación"
                android:layout_marginTop="20dp"/>
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderNivel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="1"
                android:valueTo="5"
                android:stepSize="1"
                android:value="3"
                app:trackColorActive="@color/adopta_orange"
                app:thumbTint="@color/adopta_orange"
                app:trackColorInactive="@color/adopta_blue_light"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/Adopta.Caption"
                    android:text="Le cuesta"
                    android:layout_weight="1"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/Adopta.Caption"
                    android:text="Muy cómoda"
                    android:gravity="end"
                    android:layout_weight="1"/>
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tilObservaciones"
                android:layout_marginTop="16dp"
                android:hint="Observaciones (comportamiento, alimentación, salud)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etObservaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="4"
                    android:gravity="top"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.Section"
                android:text="Fotografías"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgregarFoto"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="0dp"
                android:text="Agregar foto"
                style="@style/Adopta.Button.Outline"
                app:icon="@drawable/ic_camera"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFotosNuevas"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:clipToPadding="false"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_photo_thumb"
                tools:itemCount="3"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="Guardar seguimiento"
                style="@style/Adopta.Button"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
