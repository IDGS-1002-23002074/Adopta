<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Adopta.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="24dp"
    app:cardElevation="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ivMascota"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="center"
            android:contentDescription="Foto de la mascota"
            app:layout_constraintDimensionRatio="4:5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:background="@drawable/bg_scrim_bottom"
            app:layout_constraintStart_toStartOf="@id/ivMascota"
            app:layout_constraintEnd_toEndOf="@id/ivMascota"
            app:layout_constraintBottom_toBottomOf="@id/ivMascota" />

        <ImageButton
            android:id="@+id/btnFavorito"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="Quitar de guardados"
            android:padding="8dp"
            android:src="@drawable/ic_bookmark_filled"
            app:tint="@color/white"
            app:layout_constraintEnd_toEndOf="@id/ivMascota"
            app:layout_constraintTop_toTopOf="@id/ivMascota" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            app:layout_constraintStart_toStartOf="@id/ivMascota"
            app:layout_constraintEnd_toEndOf="@id/ivMascota"
            app:layout_constraintBottom_toBottomOf="@id/ivMascota">
            <TextView
                android:id="@+id/tvNombre"
                style="@style/Adopta.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="20sp"
                tools:text="Luna" />
            <TextView
                android:id="@+id/tvRaza"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/adopta_white_90"
                android:textSize="13sp"
                tools:text="Mestiza" />
            <TextView
                android:id="@+id/tvUbicacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/adopta_white_90"
                android:textSize="12sp"
                tools:text="León, Gto." />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
