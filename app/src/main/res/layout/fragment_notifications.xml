<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/adopta_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Adopta.Title"
                android:textSize="24sp"
                android:text="Actividad"
                android:layout_weight="1" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeerTodas"
                style="@style/Adopta.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Marcar leídas"
                android:textSize="13sp" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Adopta.Subtitle"
            android:text="Avisos de tus solicitudes, documentos y mascotas"
            android:layout_marginTop="2dp"
            android:textSize="14sp" />
    </LinearLayout>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:chipSpacingHorizontal="8dp">
            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodas"
                style="@style/Adopta.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todas" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipSolicitudes"
                style="@style/Adopta.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solicitudes" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipDocumentos"
                style="@style/Adopta.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Documentos" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipSeguimiento"
                style="@style/Adopta.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seguimiento" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipComunidad"
                style="@style/Adopta.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comunidad" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipDevoluciones"
                style="@style/Adopta.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Devoluciones" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNotificaciones"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="96dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/adopta_teal_dark" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:id="@+id/layoutEmpty"
            android:gravity="center"
            android:padding="40dp"
            android:visibility="gone">
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_icon_bubble">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/adopta_teal" />
            </FrameLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvEmptyTitle"
                style="@style/Adopta.Section"
                android:layout_marginTop="20dp"
                android:text="Sin notificaciones" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvEmptyMsg"
                style="@style/Adopta.Subtitle"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Aquí verás los avisos de tus solicitudes y mascotas." />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
