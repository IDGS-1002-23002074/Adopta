<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/adopta_teal_dark"
        app:title=""
        app:titleTextColor="@color/adopta_text"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Subtitle1" />
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="8dp"
            android:paddingBottom="28dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:adjustViewBounds="true"
                android:contentDescription="Adopta+"
                android:src="@drawable/logo_wordmark" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.Title"
                android:textSize="26sp"
                android:text="Crea tu cuenta"
                android:layout_marginTop="28dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.Subtitle"
                android:text="Regístrate como adoptante para conocer a las mascotas que buscan hogar."
                android:layout_marginTop="4dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.CardTitle"
                android:text="Nombre(s)"
                android:textSize="14sp"
                android:layout_marginTop="22dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etNombre" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNombre"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:startIconDrawable="@drawable/ic_person">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:importantForAutofill="yes"
                    android:autofillHints="givenName" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.CardTitle"
                android:text="Apellido paterno"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etPaterno" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPaterno"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:startIconDrawable="@drawable/ic_person">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPaterno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.CardTitle"
                android:text="Apellido materno (opcional)"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etMaterno" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMaterno"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:startIconDrawable="@drawable/ic_person">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMaterno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.CardTitle"
                android:text="Teléfono (opcional)"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etTelefono" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTelefono"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:startIconDrawable="@drawable/ic_phone">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:importantForAutofill="yes"
                    android:autofillHints="phone" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.CardTitle"
                android:text="Correo electrónico"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etEmail" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:startIconDrawable="@drawable/ic_email">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:importantForAutofill="yes"
                    android:autofillHints="emailAddress" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.CardTitle"
                android:text="Contraseña"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etPassword" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:startIconDrawable="@drawable/ic_lock"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:importantForAutofill="yes"
                    android:autofillHints="newPassword" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.Caption"
                android:text="Mínimo 8 caracteres, con letras y números."
                android:layout_marginTop="4dp"
                android:layout_marginStart="2dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.CardTitle"
                android:text="Confirmar contraseña"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etPassword2" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword2"
                style="@style/Adopta.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:startIconDrawable="@drawable/ic_lock"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:importantForAutofill="yes"
                    android:autofillHints="newPassword" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbTerminos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Acepto los términos y condiciones y el aviso de privacidad"
                android:textColor="@color/adopta_text"
                android:textSize="14sp"
                app:buttonTint="@color/adopta_teal_dark" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                style="@style/Adopta.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Crear cuenta"
                android:layout_marginTop="16dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Adopta.Body"
                    android:text="¿Ya tienes cuenta? " />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvLogin"
                    style="@style/Adopta.Link"
                    android:text="Inicia sesión"
                    android:background="?attr/selectableItemBackground" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
