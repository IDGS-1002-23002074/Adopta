<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/adopta_teal_dark"
        app:title="Preferencias"
        app:titleTextColor="@color/adopta_text"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Subtitle1" />
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="@color/adopta_teal_dark" />
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="32dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.Section"
                android:text="Mis preferencias de búsqueda"
                android:layout_marginTop="4dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.Caption"
                android:text="Se aplican con el botón &quot;Mis preferencias&quot; del catálogo."
                android:layout_marginTop="2dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.CardTitle"
                android:text="Especie"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etEspecie" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEspecie"
                style="@style/Adopta.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/etEspecie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.CardTitle"
                android:text="Tamaño"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etTamano" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTamano"
                style="@style/Adopta.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/etTamano"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.CardTitle"
                android:text="Edad"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:layout_marginStart="2dp"
                android:labelFor="@id/etEdad" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEdad"
                style="@style/Adopta.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/etEdad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.Section"
                android:text="Notificaciones"
                android:layout_marginTop="28dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.Caption"
                android:text="Elige qué avisos quieres ver en Actividad."
                android:layout_marginTop="2dp" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swNotifSolicitudes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="Solicitudes de adopción"
                android:textColor="@color/adopta_text"
                android:textSize="15sp"
                android:fontFamily="@font/inter_regular"
                app:thumbTint="@color/adopta_teal_dark" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swNotifDocumentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="Documentos pendientes"
                android:textColor="@color/adopta_text"
                android:textSize="15sp"
                android:fontFamily="@font/inter_regular"
                app:thumbTint="@color/adopta_teal_dark" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swNotifSeguimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="Seguimiento de mi mascota"
                android:textColor="@color/adopta_text"
                android:textSize="15sp"
                android:fontFamily="@font/inter_regular"
                app:thumbTint="@color/adopta_teal_dark" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swNotifComunidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="Comunidad"
                android:textColor="@color/adopta_text"
                android:textSize="15sp"
                android:fontFamily="@font/inter_regular"
                app:thumbTint="@color/adopta_teal_dark" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swNotifDevoluciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="Devoluciones"
                android:textColor="@color/adopta_text"
                android:textSize="15sp"
                android:fontFamily="@font/inter_regular"
                app:thumbTint="@color/adopta_teal_dark" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                style="@style/Adopta.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Guardar preferencias"
                android:layout_marginTop="24dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
