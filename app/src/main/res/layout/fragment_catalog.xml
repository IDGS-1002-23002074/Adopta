<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/adopta_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="Adopta+"
                android:src="@drawable/logo_wordmark"
                android:scaleType="fitStart" />
            <ImageButton
                android:id="@+id/btnGuardados"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="Mis guardados"
                android:padding="11dp"
                android:src="@drawable/ic_bookmark_outline"
                app:tint="@color/adopta_teal_dark" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Adopta.Title"
            android:textSize="24sp"
            android:text="Mascotas en adopción"
            android:layout_marginTop="16dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvContador"
            style="@style/Adopta.Subtitle"
            android:layout_marginTop="2dp"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_search_field"
            android:paddingStart="16dp"
            android:paddingEnd="6dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/adopta_teal" />
            <EditText
                android:id="@+id/etBuscar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="Buscar por nombre, raza o refugio"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/adopta_text"
                android:textSize="15sp"
                android:textColorHint="@color/adopta_gray" />
            <ImageButton
                android:id="@+id/btnLimpiarBusqueda"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Borrar búsqueda"
                android:padding="12dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/adopta_gray" />
        </LinearLayout>
    </LinearLayout>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsFiltros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:chipSpacingHorizontal="8dp">
            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodas"
                style="@style/Adopta.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todas" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipPerros"
                style="@style/Adopta.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perros" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipGatos"
                style="@style/Adopta.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gatos" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipTamano"
                style="@style/Adopta.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tamaño ▾" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipEdad"
                style="@style/Adopta.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edad ▾" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipMas"
                style="@style/Adopta.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Más filtros" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipPrefs"
                style="@style/Adopta.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mis preferencias" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMascotas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="16dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/adopta_teal_dark" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:id="@+id/layoutEmpty"
            android:gravity="center"
            android:padding="40dp"
            android:visibility="gone">
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_icon_bubble">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/adopta_teal"
                    android:id="@+id/ivEmptyIcon" />
            </FrameLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvEmptyTitle"
                style="@style/Adopta.Section"
                android:layout_marginTop="20dp"
                android:text="No encontramos mascotas" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvEmptyMsg"
                style="@style/Adopta.Subtitle"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Prueba con otra búsqueda o quita algunos filtros." />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLimpiar"
                style="@style/Adopta.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Limpiar filtros"
                android:layout_marginTop="20dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
