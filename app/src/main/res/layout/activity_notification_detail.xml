<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".NotificationDetailActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Notificación"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="@color/adopta_text"
        app:navigationIconTint="@color/adopta_teal_dark"
        android:background="@color/white"
        android:elevation="2dp"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_circle_blue">
                <ImageView
                    android:id="@+id/ivIcono"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/adopta_teal_dark"/>
            </FrameLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.Title"
                tools:text="Solicitud aceptada"
                android:id="@+id/tvTitulo"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Adopta.Caption"
                tools:text="10 oct 2026 · 09:30"
                android:id="@+id/tvTiempo"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"/>
            <TextView
                android:id="@+id/tvTipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textSize="12sp"
                android:textColor="@color/adopta_teal_dark"
                android:textStyle="bold"
                tools:text="Solicitud"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"/>
            <com.google.android.material.card.MaterialCardView
                style="@style/Adopta.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Adopta.Body"
                        tools:text="Tu solicitud para adoptar a Luna fue aceptada. Ponte en contacto con el refugio para coordinar la entrega y los siguientes pasos."
                        android:id="@+id/tvMensaje"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAccion"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="Ver detalle"
                style="@style/Adopta.Button"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarcarLeida"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Marcar como leída"
                style="@style/Adopta.Button.Outline"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
