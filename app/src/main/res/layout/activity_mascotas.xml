<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ad_bg"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mascotas"
                android:textSize="30sp"
                android:textColor="@color/ad_ink"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingMultiplier="1.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24 disponibles para adoptar"
                android:textSize="15sp"
                android:textColor="@color/ad_muted"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <EditText
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="0dp"
                    android:hint="Buscar por nombre o raza"
                    android:background="@drawable/bg_search"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="15sp"
                    android:textColor="@color/ad_ink"
                    android:textColorHint="@color/ad_hint"
                    android:inputType="text"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/ad_muted" />

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_tune"
                    android:scaleType="center"
                    android:tint="@color/ad_ink"
                    android:contentDescription="Filtros"
                    android:background="@drawable/bg_icon_button"
                    android:layout_marginStart="10dp" />

            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Todos"
                        android:textSize="14sp"
                        android:textColor="@color/ad_on_accent"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:background="@drawable/bg_chip_selected" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Perros"
                        android:textSize="14sp"
                        android:textColor="@color/ad_ink"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:background="@drawable/bg_chip"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Gatos"
                        android:textSize="14sp"
                        android:textColor="@color/ad_ink"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:background="@drawable/bg_chip"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Conejos"
                        android:textSize="14sp"
                        android:textColor="@color/ad_ink"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:background="@drawable/bg_chip"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Otros"
                        android:textSize="14sp"
                        android:textColor="@color/ad_ink"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:background="@drawable/bg_chip"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="22dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="24 resultados"
                    android:textSize="13sp"
                    android:textColor="@color/ad_muted"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Más recientes"
                    android:textSize="13sp"
                    android:textColor="@color/ad_ink"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:src="@drawable/ic_photo"
                        android:scaleType="center"
                        android:contentDescription="Foto de Max"
                        android:background="@drawable/bg_photo_a" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Disponible"
                        android:textSize="12sp"
                        android:textColor="@color/ad_teal"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_badge"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp" />

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_favorite_border"
                        android:scaleType="center"
                        android:tint="@color/ad_peach_accent"
                        android:contentDescription="Guardar en favoritos"
                        android:background="@drawable/bg_circle_white"
                        android:layout_gravity="top|end"
                        android:layout_margin="12dp" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Max"
                        android:textSize="22sp"
                        android:textColor="@color/ad_ink"
                        android:fontFamily="sans-serif-medium"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 años"
                        android:textSize="14sp"
                        android:textColor="@color/ad_ink"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Labrador retriever, macho, mediano"
                    android:textSize="14sp"
                    android:textColor="@color/ad_muted"
                    android:layout_marginTop="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vacunado"
                        android:textSize="12sp"
                        android:textColor="@color/ad_ink_soft"
                        android:background="@drawable/bg_tag"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:layout_marginStart="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Esterilizado"
                        android:textSize="12sp"
                        android:textColor="@color/ad_ink_soft"
                        android:background="@drawable/bg_tag"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:layout_marginStart="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sociable"
                        android:textSize="12sp"
                        android:textColor="@color/ad_ink_soft"
                        android:background="@drawable/bg_tag"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:layout_marginStart="6dp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="32dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:src="@drawable/ic_photo"
                        android:scaleType="center"
                        android:contentDescription="Foto de Luna"
                        android:background="@drawable/bg_photo_b" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Disponible"
                        android:textSize="12sp"
                        android:textColor="@color/ad_teal"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_badge"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp" />

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_favorite_border"
                        android:scaleType="center"
                        android:tint="@color/ad_peach_accent"
                        android:contentDescription="Guardar en favoritos"
                        android:background="@drawable/bg_circle_white"
                        android:layout_gravity="top|end"
                        android:layout_margin="12dp" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Luna"
                        android:textSize="22sp"
                        android:textColor="@color/ad_ink"
                        android:fontFamily="sans-serif-medium"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 año"
                        android:textSize="14sp"
                        android:textColor="@color/ad_ink"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Siamés, hembra, pequeña"
                    android:textSize="14sp"
                    android:textColor="@color/ad_muted"
                    android:layout_marginTop="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vacunada"
                        android:textSize="12sp"
                        android:textColor="@color/ad_ink_soft"
                        android:background="@drawable/bg_tag"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:layout_marginStart="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tranquila"
                        android:textSize="12sp"
                        android:textColor="@color/ad_ink_soft"
                        android:background="@drawable/bg_tag"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:layout_marginStart="6dp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="32dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:src="@drawable/ic_photo"
                        android:scaleType="center"
                        android:contentDescription="Foto de Toby"
                        android:background="@drawable/bg_photo_c" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En proceso"
                        android:textSize="12sp"
                        android:textColor="@color/ad_peach_text"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_badge"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp" />

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_favorite_border"
                        android:scaleType="center"
                        android:tint="@color/ad_peach_accent"
                        android:contentDescription="Guardar en favoritos"
                        android:background="@drawable/bg_circle_white"
                        android:layout_gravity="top|end"
                        android:layout_margin="12dp" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Toby"
                        android:textSize="22sp"
                        android:textColor="@color/ad_ink"
                        android:fontFamily="sans-serif-medium"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 años"
                        android:textSize="14sp"
                        android:textColor="@color/ad_ink"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mestizo, macho, grande"
                    android:textSize="14sp"
                    android:textColor="@color/ad_muted"
                    android:layout_marginTop="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vacunado"
                        android:textSize="12sp"
                        android:textColor="@color/ad_ink_soft"
                        android:background="@drawable/bg_tag"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:layout_marginStart="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Entrenado"
                        android:textSize="12sp"
                        android:textColor="@color/ad_ink_soft"
                        android:background="@drawable/bg_tag"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:layout_marginStart="6dp" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp" />

        </LinearLayout>

    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ad_line"
        android:layout_marginTop="0dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/ad_bg">

        <TextView
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:text="Inicio"
            android:textSize="11sp"
            android:textColor="@color/ad_nav_idle"
            android:fontFamily="sans-serif-medium"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:drawableTop="@drawable/ic_home"
            android:drawablePadding="3dp"
            android:drawableTint="@color/ad_nav_idle" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:text="Mascotas"
            android:textSize="11sp"
            android:textColor="@color/ad_teal"
            android:fontFamily="sans-serif-medium"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:drawableTop="@drawable/ic_pets"
            android:drawablePadding="3dp"
            android:drawableTint="@color/ad_teal" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:text="Solicitudes"
            android:textSize="11sp"
            android:textColor="@color/ad_nav_idle"
            android:fontFamily="sans-serif-medium"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:drawableTop="@drawable/ic_assignment"
            android:drawablePadding="3dp"
            android:drawableTint="@color/ad_nav_idle" />

    </LinearLayout>

</LinearLayout>
